# ╔═══════════════════════════════════════════════════════════════╗
# ║  Smart Teacher — Production Environment Configuration       ║
# ║  ⚠️  يجب تعبئة جميع القيم قبل تشغيل السيرفر               ║
# ╚═══════════════════════════════════════════════════════════════╝

# ─── Django Core ──────────────────────────────────────
# ⚠️ أنشئ مفتاح سري فريد: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE-ME-generate-a-strong-secret-key

DEBUG=False

# أضف الدومين/IP الخاص بك (مفصولين بفاصلة)
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# ─── PostgreSQL Database ─────────────────────────────
DB_NAME=smart_teacher
DB_USER=smart_teacher_user
DB_PASSWORD=CHANGE-ME-strong-database-password
DB_HOST=localhost
DB_PORT=5432

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ─── CORS ────────────────────────────────────────────
CORS_ALLOW_ALL=False
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ─── OTP SMS Provider ───────────────────────────────
# Production يستخدم Yemen Local SMS Provider
SMS_PROVIDER=apps.accounts.providers.yemen_local_provider.YemenLocalOTPProvider

# ─── Yemen SMS API (مطلوب للإنتاج) ──────────────────
YEMEN_SMS_API_URL=https://api.your-sms-provider.com/send
YEMEN_SMS_API_KEY=your-sms-api-key
YEMEN_SMS_SENDER_ID=SmartTeacher

# ─── Firebase (إشعارات Push) ────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json
NOTIFICATION_EXPIRY_REMINDER_DAYS=3

# ─── Security Secrets ───────────────────────────────
# ⚠️ أنشئ مفاتيح فريدة: python -c "import secrets; print(secrets.token_urlsafe(64))"
OTP_HASH_SECRET=CHANGE-ME-generate-unique-otp-secret
ACTIVATION_CODE_HMAC_SECRET=CHANGE-ME-generate-unique-activation-secret

# ─── Assessment Settings ────────────────────────────
ASSESSMENT_SECONDS_PER_QUESTION=60
ASSESSMENT_LESSON_MINISTERIAL_TARGET_SIZE=20
ASSESSMENT_UNIT_MINISTERIAL_MAX_SIZE=50
ASSESSMENT_CUSTOM_MAX_QUESTIONS=50
ASSESSMENT_CUSTOM_MAX_DURATION_MINUTES=300
